{
  "name": "flapkit",
  "main": "worker.mjs",
  "routes": [
    { "pattern": "cuvii.dev/flapkit", "zone_name": "cuvii.dev" },
    { "pattern": "cuvii.dev/flapkit/*", "zone_name": "cuvii.dev" },
    { "pattern": "flapkit.cuvii.dev", "custom_domain": true }
  ],
  "compatibility_date": "2026-09-05",
  // NEXT_PUBLIC_POSTHOG_* is inlined by `next build`. Set it in
  // Workers Builds → Settings → Build → Variables and secrets, not here.
  "assets": {
    "directory": "./deploy-assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
}
