{
  "name": "@thecuvii/flapkit",
  "version": "0.0.0",
  "description": "React split-flap display components and looks.",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sound": {
      "development": "./src/sound/index.ts",
      "types": "./dist/sound/index.d.ts",
      "import": "./dist/sound/index.js"
    },
    "./flapkit.css": {
      "development": "./src/styles/flapkit.css",
      "default": "./dist/styles/flapkit.css"
    },
    "./airport.css": {
      "development": "./src/styles/airport.css",
      "default": "./dist/styles/airport.css"
    },
    "./industrial.css": {
      "development": "./src/styles/industrial.css",
      "default": "./dist/styles/industrial.css"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./sound": {
        "types": "./dist/sound/index.d.ts",
        "import": "./dist/sound/index.js"
      },
      "./flapkit.css": "./dist/styles/flapkit.css",
      "./airport.css": "./dist/styles/airport.css",
      "./industrial.css": "./dist/styles/industrial.css"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:website": "pnpm build && pnpm --filter website build",
    "deploy": "pnpm build:website && npx wrangler deploy --config website/wrangler.jsonc",
    "check": "pnpm build && vp check && tsc -p website/tsconfig.json",
    "check:fix": "pnpm build && vp check --fix && tsc -p website/tsconfig.json",
    "dev": "pnpm --filter website dev",
    "fmt": "oxfmt",
    "lint": "oxlint .",
    "prepack": "pnpm build",
    "test": "vp test run",
    "test:browser": "vp test run --config vitest.browser.config.ts",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "@vitest/browser-playwright": "4.1.11",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "playwright": "^1.63.0",
    "react": "catalog:frontend",
    "react-dom": "catalog:frontend",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:dev",
    "vite-plus": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.0.0"
}
