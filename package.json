{
  "name": "flapkit",
  "version": "0.1.0",
  "description": "React split-flap display components and looks.",
  "homepage": "https://cuvii.dev/flapkit/",
  "bugs": {
    "url": "https://github.com/thecuvii/flapkit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thecuvii/flapkit.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sound": {
      "types": "./dist/sound/index.d.ts",
      "import": "./dist/sound/index.js"
    },
    "./motion/canvas/cascade": {
      "types": "./dist/motion/canvas/cascade.d.ts",
      "import": "./dist/motion/canvas/cascade.js"
    },
    "./motion/canvas/riffle": {
      "types": "./dist/motion/canvas/riffle.d.ts",
      "import": "./dist/motion/canvas/riffle.js"
    },
    "./motion/css/cascade": {
      "types": "./dist/motion/css/cascade.d.ts",
      "import": "./dist/motion/css/cascade.js"
    },
    "./flapkit.css": {
      "types": "./dist/styles/style.d.ts",
      "default": "./dist/styles/flapkit.css"
    },
    "./airport.css": {
      "types": "./dist/styles/style.d.ts",
      "default": "./dist/styles/airport.css"
    },
    "./industrial.css": {
      "types": "./dist/styles/style.d.ts",
      "default": "./dist/styles/industrial.css"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "tsdown",
    "build:website": "pnpm build && pnpm --filter website build",
    "deploy": "pnpm build:website && npx wrangler deploy --config website/wrangler.jsonc",
    "check": "pnpm build && vp check && tsc -p website/tsconfig.json",
    "check:fix": "pnpm build && vp check --fix && tsc -p website/tsconfig.json",
    "dev": "pnpm --filter website dev",
    "fmt": "oxfmt",
    "lint": "oxlint .",
    "prepack": "pnpm build",
    "test": "vp test run",
    "test:browser": "vp test run --config vitest.browser.config.ts",
    "test:docs": "node tests/docs.e2e.mjs",
    "test:package": "node tests/package.e2e.mjs",
    "prepare": "vp config --no-agent",
    "test:visual": "FLAPKIT_VISUAL_TESTS=1 FLAPKIT_BROWSER=chromium vp test run --config vitest.browser.config.ts",
    "check:release": "pnpm check && pnpm test:docs-examples && pnpm test && pnpm test:browser && pnpm test:visual && pnpm test:package && pnpm test:react-min",
    "test:react-min": "FLAPKIT_REACT_VERSION=19.0.0 node tests/package.e2e.mjs",
    "test:subpath": "node tests/subpath.e2e.mjs",
    "test:docs-examples": "node tests/docs-examples.mjs"
  },
  "devDependencies": {
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "@vitest/browser-playwright": "4.1.11",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "playwright": "^1.63.0",
    "react": "catalog:frontend",
    "react-dom": "catalog:frontend",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:dev",
    "vite-plus": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.0.0"
}
