{
  "name": "@thecuvii/flapkit",
  "version": "0.0.0",
  "description": "React split-flap display components and looks.",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sound": {
      "types": "./dist/sound/index.d.ts",
      "import": "./dist/sound/index.js"
    },
    "./flapkit.css": "./dist/styles/flapkit.css",
    "./airport.css": "./dist/styles/airport.css",
    "./industrial.css": "./dist/styles/industrial.css",
    "./signal.css": "./dist/styles/signal.css"
  },
  "scripts": {
    "build": "vp pack",
    "build:website": "pnpm build && vp -C website build",
    "check": "pnpm build && vp check && tsc -p website/tsconfig.json",
    "check:fix": "pnpm build && vp check --fix && pnpm build && tsc -p website/tsconfig.json",
    "dev": "pnpm build && vp -C website dev",
    "prepack": "pnpm build",
    "test": "vp test run",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plus": "0.3.0",
    "vitest": "4.1.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.0.0"
}
